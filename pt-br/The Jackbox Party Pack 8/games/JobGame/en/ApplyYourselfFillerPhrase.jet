  },
  {
   "id": "76940",
   "isValid": "",
   "phrase": "Eu não posso consertar todos os seus erros!",
   "x": false
  },
  {
   "id": "76942",
   "isValid": "",
   "phrase": "Esta bala de hortelã é um pouco ardida demais para o meu gosto.",
   "x": false
  },
  {
   "id": "76943",
   "isValid": "",
   "phrase": "Nada tem um gosto melhor do que o bolo de carne da minha mãe!",

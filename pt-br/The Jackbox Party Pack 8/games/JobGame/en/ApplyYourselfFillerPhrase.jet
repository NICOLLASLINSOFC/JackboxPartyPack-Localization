  },
  {
   "id": "78041",
   "isValid": "",
   "phrase": "Essa é a minha especialidade, sabe? Chamegos!",
   "x": false
  },
  {
   "id": "79478",
   "isValid": "",
   "phrase": "Nunca pensei que teria um cavalo, muito menos um tão peludinho.",
